# BlissNova Ad Network — environment template.
# Copy to .env and fill in. Every value here is a placeholder; generate your own
# secrets and never commit the filled-in file.
#
# No public domain is configured anywhere in the code. The URLs below default to
# localhost; set them to your own host when you have one.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------- datastores
DATABASE_URL=postgres://blissnova:change-me@localhost:5432/blissnova
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- public URLs
# Where the dashboard is served (used in emails and redirects).
PUBLIC_SITE_URL=http://localhost:3000
# Where this API is reachable from browsers (used by the JavaScript ad tag).
PUBLIC_API_URL=http://localhost:4000
# Domain publishers list in ads.txt and buyers see in sellers.json. Empty = the host of PUBLIC_SITE_URL.
ADS_TXT_DOMAIN=
# Comma-separated origins allowed to call management endpoints with cookies.
CORS_ORIGINS=http://localhost:3000

# Set to true only when running behind a proxy/CDN you control, so that
# X-Forwarded-For is trusted for rate limiting and IP hashing.
TRUST_PROXY=false
# Header your CDN sets with the visitor's ISO country (e.g. cf-ipcountry).
# Leave empty if you have none: country targeting then reports "ZZ" (unknown).
# There is no bundled GeoIP database.
GEO_COUNTRY_HEADER=
# false only for plain-http local development.
COOKIE_SECURE=true
SESSION_TTL_HOURS=336

# ---------------------------------------------------------------- secrets
# All three are REQUIRED and have no defaults.
#
# 32+ random characters. HMAC key for pseudonymous IP/visitor hashes and
# email tokens. Rotating it invalidates outstanding email links.
#   openssl rand -base64 48
APP_SECRET=replace-with-at-least-32-random-characters

# Exactly 32 bytes, base64. Encrypts MFA secrets at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Delivery/tracking token key ring: "kid:base64key,kid2:base64key2".
# The FIRST entry signs new tokens; the others are still accepted, which is how
# you rotate without dropping in-flight impressions.
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TRACKING_TOKEN_KEYS=k1:replace-with-32-byte-base64-key

# ---------------------------------------------------------------- storage
# Creative images are written here (content-addressed). Use a persistent volume.
STORAGE_DIR=./storage

# ---------------------------------------------------------------- email
# log      = write the message to the application log (development)
# disabled = drop all mail (emails stay queued in email_outbox)
# smtp     = send via the SMTP settings below
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---------------------------------------------------------------- payments
# No payment provider is connected by default. Leave these empty and account
# funding happens by manual bank transfer confirmed by platform finance staff.
# Supply real keys only when you have your own Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development-only simulated payment provider. Credits a balance without any
# money moving. Startup fails if this is true while NODE_ENV=production.
ENABLE_DEV_PAYMENTS=false

# ---------------------------------------------------------------- pipeline
# inline = score and bill tracking events inside the request (tests, tiny installs)
# queue  = hand off to the worker via Redis (recommended; requires apps/worker)
EVENT_PROCESSING=queue

# ---------------------------------------------------------------- verification
# Development overrides for site-ownership verification. Both must be unset in
# production, where only https and public IP addresses are fetched.
VERIFICATION_ALLOW_HTTP=false
VERIFICATION_PRIVATE_HOST_ALLOWLIST=
# Development-only simulator that marks a site verified without checking DNS,
# a file or a meta tag (the local demo uses it). Startup fails if this is true
# while NODE_ENV=production.
ENABLE_DEV_VERIFICATION_SIMULATOR=false

# Optional: POST unhandled server errors as JSON to this URL.
ERROR_REPORT_WEBHOOK_URL=

# ---------------------------------------------------------------- seeding
# Demo seed data (pnpm db:seed) is fictional and tagged "[demo]".
# Required only if you insist on seeding with NODE_ENV=production.
SEED_DEMO_DATA=false
# Password for the seeded demo logins. If unset, a random one is printed once.
SEED_PASSWORD=

# ---------------------------------------------------------------- web app (apps/web)
# Where the web server proxies /api/v1, /sdk and /assets. Read at BUILD time
# (next build), so rebuild the web app after changing it.
API_INTERNAL_URL=http://localhost:4000
# Public address of the web app, used for canonical links. Optional.
NEXT_PUBLIC_SITE_URL=
# true shows the demo-data notice and the simulated checkout page. Local demo only.
NEXT_PUBLIC_DEMO_MODE=false
# Optional brand overrides shown in the UI. No company details are invented:
# leave empty until you have real ones.
NEXT_PUBLIC_BRAND_PRODUCT_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_BRAND_COMPANY_NAME=
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
