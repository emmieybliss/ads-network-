{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/). Only
		# requests from these addresses may name the visitor's IP; anyone else
		# is taken at their real address. Update if Cloudflare adds ranges.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(upstream_headers) {
	# Hand the API exactly one, trustworthy visitor address. Invalid-traffic
	# checks, frequency caps and rate limits all key on it.
	header_up X-Forwarded-For {client_ip}
}

# Redirect www to the bare domain.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 6MB
	}

	# Ad traffic, the SDK, webhooks and API docs go straight to the API.
	@api path /api/v1/* /sdk/* /assets/* /api/docs* /sellers.json /health /ready
	handle @api {
		reverse_proxy api:4000 {
			import upstream_headers
		}
	}

	handle {
		reverse_proxy web:3000 {
			import upstream_headers
		}
	}
}
