# Production settings for deploy/docker-compose.prod.yml.
# Copy to deploy/prod.env, fill in every CHANGE line, and keep it private:
#   chmod 600 deploy/prod.env
# deploy/gen-secrets.sh prints fresh values for the five secret lines.

# ---- Your domain (no https://, no trailing slash) -------------------------
SITE_DOMAIN=CHANGE.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=CHANGE@example.com

# ---- Secrets (generate with deploy/gen-secrets.sh) -----------------------
POSTGRES_PASSWORD=CHANGE
APP_SECRET=CHANGE
ENCRYPTION_KEY=CHANGE
TRACKING_TOKEN_KEYS=CHANGE
# Must repeat POSTGRES_PASSWORD exactly.
DATABASE_URL=postgres://blissnova:CHANGE@postgres:5432/blissnova

# ---- Your domain again, with https:// (same as SITE_DOMAIN) ------------
PUBLIC_SITE_URL=https://CHANGE.example.com
PUBLIC_API_URL=https://CHANGE.example.com
CORS_ORIGINS=https://CHANGE.example.com

# ---- Fixed for this layout -----------------------------------------------
NODE_ENV=production
REDIS_URL=redis://redis:6379
COOKIE_SECURE=true
TRUST_PROXY=true
EVENT_PROCESSING=queue
STORAGE_DIR=/data/storage
LOG_LEVEL=info
SEED_DEMO_DATA=false
ENABLE_DEV_PAYMENTS=false
ENABLE_DEV_VERIFICATION_SIMULATOR=false
ENABLE_DEV_PARTNER_SIMULATOR=false
VERIFICATION_ALLOW_HTTP=false

# Behind Cloudflare's proxy (orange cloud), Cloudflare tells us the visitor's country.
# Leave empty if you are not using Cloudflare's proxy.
GEO_COUNTRY_HEADER=cf-ipcountry
# Fallback when there is no header (or Cloudflare's proxy is off): a free
# DB-IP Lite country database, downloaded here and refreshed monthly with no
# restart. It lives on the storage volume so it survives redeploys.
GEOIP_DB_PATH=/data/storage/geo/country.mmdb
GEOIP_AUTO_UPDATE=true
# Empty until you register with IAB Europe; EU visitors then get contextual ads only.
TCF_VENDOR_ID=

# ---- Email (Brevo SMTP relay shown; any SMTP provider works) --------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE
SMTP_PASS=CHANGE

# ---- Payments: fill in only the ones you have live accounts for ----------
# Paystack (business registered in Nigeria, Ghana, Kenya or South Africa). Live key only.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=NGN,USD
# Stripe (needs a business in a Stripe-supported country). Live keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (live app). All three together.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=live

# Optional: a Slack or Discord webhook that receives server errors.
ERROR_REPORT_WEBHOOK_URL=
