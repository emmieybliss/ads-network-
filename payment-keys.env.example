# Test-mode payment keys for the local demo (optional).
# Copy this file to payment-keys.env in the same folder, fill in the keys you
# have, then restart the demo. Only TEST keys are accepted; live keys are
# ignored, because the demo must never take real money. payment-keys.env is
# never committed.

# Paystack: dashboard -> Settings -> API Keys & Webhooks -> Test Secret Key
PAYSTACK_SECRET_KEY=
# Currencies your Paystack account is enabled for.
PAYSTACK_CURRENCIES=NGN,USD

# Stripe: dashboard (Test mode) -> Developers -> API keys -> Secret key.
# The webhook secret comes from `stripe listen` (see docs/PAYMENTS_AND_PAYOUTS.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox app: developer.paypal.com -> Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
